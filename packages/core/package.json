{
  "name": "@nepalpay/core",
  "version": "0.2.3",
  "description": "Shared types and utilities for the @nepalpay payment gateway SDKs (unofficial)",
  "author": "Anish Bhattarai",
  "license": "MIT",
  "homepage": "https://github.com/anishbhattarai-asm/nepal-pay/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishbhattarai-asm/nepal-pay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/anishbhattarai-asm/nepal-pay/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests --exclude \"**/live/**\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
