{
  "name": "@nepalpay/esewa",
  "version": "0.1.0",
  "description": "Unofficial zero-dependency eSewa ePay v2 SDK for Node.js and edge runtimes",
  "keywords": [
    "esewa",
    "nepal",
    "payment",
    "epay"
  ],
  "author": "Anish Bhattarai",
  "license": "MIT",
  "homepage": "https://github.com/anishbhattarai-asm/nepal-pay/tree/main/packages/esewa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishbhattarai-asm/nepal-pay.git",
    "directory": "packages/esewa"
  },
  "bugs": {
    "url": "https://github.com/anishbhattarai-asm/nepal-pay/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nepalpay/core": "^0.1.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests --exclude \"**/live/**\"",
    "test:live": "vitest run tests/live",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
