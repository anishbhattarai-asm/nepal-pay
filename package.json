{
  "name": "nepal-pay",
  "private": true,
  "author": "Anish Bhattarai",
  "license": "MIT",
  "homepage": "https://github.com/anishbhattarai-asm/nepal-pay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishbhattarai-asm/nepal-pay.git"
  },
  "bugs": {
    "url": "https://github.com/anishbhattarai-asm/nepal-pay/issues"
  },
  "workspaces": [
    "packages/core",
    "packages/esewa",
    "packages/khalti",
    "packages/connectips",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w packages/core -w packages/esewa -w packages/khalti -w packages/connectips",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm test",
    "demo": "npm run build:packages && npm start -w express-demo",
    "release": "npm run check && node scripts/release.mjs",
    "demo:next": "npm run build:packages && npm run dev -w nextjs-demo"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
